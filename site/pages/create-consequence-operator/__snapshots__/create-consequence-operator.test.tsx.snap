                      value="yes"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div
            class="govuk-form-group"
          >
            <div
              class="govuk-form-group"
              id="disruption-severity"
            >
              <label
                class="govuk-label govuk-label--l"
                for="disruption-severity-input"
              >
                Disruption severity
              </label>
              <div
                class=""
              >
                <select
                  class="govuk-select w-3/4"
                  id="disruption-severity-input"
                  name="disruptionSeverity"
                >
                  <option
                    disabled=""
                    value=""
                  >
                    Select severity
                  </option>
                  <option
                    value="unknown"
                  >
                    Unknown
                  </option>
                  <option
                    value="verySlight"
                  >
                    Very slight
                  </option>
                  <option
                    value="slight"
                  >
                    Slight
                  </option>
                  <option
                    value="normal"
                  >
                    Normal
                  </option>
                  <option
                    selected=""
                    value="severe"
                  >
                    Severe
                  </option>
                  <option
                    value="verySevere"
                  >
                    Very severe
                  </option>
                </select>
              </div>
            </div>
          </div>
          <input
            name="consequenceType"
            type="hidden"
            value="operatorWide"
          />
          <input
            name="disruptionId"
            type="hidden"
            value="aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
          />
          <input
            name="consequenceIndex"
            type="hidden"
          />
          <button
            class="govuk-button mt-8"
            data-module="govuk-button"
          >
            Save and continue
          </button>
          <button
            class="govuk-button mt-8 ml-5 govuk-button--secondary"
            data-module="govuk-button"
            formaction="/api/create-consequence-operator?draft=true"
          >
            Save as draft
          </button>
          <button
            class="govuk-button mt-8 ml-5 govuk-button--secondary"
            data-module="govuk-button"
            formaction="/api/create-consequence-operator?addAnotherConsequence=true"
          >
            Add another consequence
          </button>
        </div>
      </form>
    </main>
